# Seeders for a Railway deploy: runs scripts/run-seeders.sh once and exits.
# Railway runs it on a cron (railway.seeders.json). The self-host guide runs the
# same script from the host's crontab; this is that, in its own container.
FROM node:24-alpine
RUN apk add --no-cache coreutils
WORKDIR /app
COPY scripts/package.json scripts/package-lock.json ./scripts/
COPY scripts/vendor/deepmerge/ ./scripts/vendor/deepmerge/
ENV npm_config_install_links=true
# Same install as Dockerfile.relay: vendored deepmerge needs install_links, and
# --ignore-scripts keeps native build helpers off Alpine.
RUN npm ci --prefix scripts --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund \
 && npm install --prefix scripts --no-save --ignore-scripts --no-audit --no-fund "typescript@npm:@typescript/typescript6@^6.0.2"
COPY . .
ENV SEED_TIMEOUT=900
CMD ["sh", "scripts/run-seeders.sh"]
